{
  "name": "mengka-nt-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs && node scripts/verify-search-index.mjs",
    "preview": "vitepress preview docs",
    "test": "node --test tests/*.test.mjs",
    "sync:api-protocols": "node scripts/sync-api-protocol-labels.mjs",
    "sync:api-categories": "node scripts/sync-api-categories.mjs",
    "check:api-categories": "node scripts/sync-api-categories.mjs --check",
    "check:api-protocols": "node scripts/sync-api-protocol-labels.mjs --check && node scripts/verify-api-protocol-labels.mjs",
    "check": "npm test && npm run check:api-categories && npm run check:api-protocols && npm run build && node scripts/check-built-links.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "harmonyos-sans-sc-webfont-splitted": "1.1.0",
    "vitepress": "1.6.4",
    "vue": "3.5.21"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
